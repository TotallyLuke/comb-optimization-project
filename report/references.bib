@article{KHODABAKHSHI2021426,
title = {Optimization of Non-Productive Tool Path in Drilling: A Review},
journal = {IFAC-PapersOnLine},
volume = {54},
number = {1},
pages = {426-431},
year = {2021},
note = {17th IFAC Symposium on Information Control Problems in Manufacturing INCOM 2021},
issn = {2405-8963},
doi = {https://doi.org/10.1016/j.ifacol.2021.08.048},
url = {https://www.sciencedirect.com/science/article/pii/S2405896321007667},
author = {Z. Khodabakhshi and A. Hosseini},
keywords = {Intelligent Manufacturing systems, Modeling of manufacturing operations, Intelligent Drilling, Tool path Optimization, Travelling Salesman Problem},
abstract = {Global competition and rapidly changing markets require more innovative and efficient manufacturing processes and systems. In this context, intelligent machining has recently become of great interest and optimization of intelligent machining systems has been one of the primary topics of research and development. Optimization of machining operations embraces topics such as optimization of tool path, optimization of machining parameters, etc. Among the machining operations, this paper is focused on drilling and it studies methodologies and approaches for optimization of tool path generation in drilling. The current paper presents a clear yet concise understanding of the typical problems in drilling tool path optimization, describes different approaches to solve these problems, and finally reviews the remaining challenges in this field.}
}




